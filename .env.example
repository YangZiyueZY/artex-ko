# Docker 部署配置（把本文件复制为 .env 即可）
# ARTEX_TAG 是 docker-compose 拉取的镜像 ghcr.io/jiwoochris/artex-global 的标签。
# latest 指向最近一次发布；要固定到某个发行版，请填写 v* 标签。
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（填其中一个或两个都填；也可以留空，稍后在 UI 中设置）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# 首次运行保护（防止管理员账号被远程抢占）
# - Web/API 端口默认只发布到主机的 127.0.0.1。如需从其他设备直接
#   访问，请改为 ARTEX_BIND=0.0.0.0，但请先完成初始设置。
# - 首次启动时日志中会打印随机设置 token（docker compose logs artex），
#   必须在 /setup 页面输入该值才能创建管理员密码。
#   指定 ARTEX_SETUP_TOKEN 时，该值即为 token，且不会打印到日志。
# - 指定 ARTEX_ADMIN_PASSWORD 时，无需 /setup，直接用该值初始化（至少 8 个字符）。
ARTEX_BIND=127.0.0.1
ARTEX_SETUP_TOKEN=
ARTEX_ADMIN_PASSWORD=
# 浏览器跨源（CORS）允许列表（逗号分隔）。内置 UI 同源，通常留空。
ARTEX_CORS_ORIGINS=

# 服务端默认输出语言（zh·en·ko·es·ja）。本示例默认设为 zh；留空则回落到程序内置默认值。
# - 作为智能体报告、摘要、对话回复以及服务端错误消息的默认值；在设置页面
#   选择“显示语言”后，以该选择为优先。
# - 服务端控制台日志只遵循此值（与设置页面的选择无关）。
# - Web 界面文案的语言由各浏览器在设置页面中选择。
ARTEX_LANG=zh
